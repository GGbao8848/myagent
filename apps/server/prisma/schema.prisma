generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String    @id @default(cuid())
  title     String    @default("新对话")
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id        Int      @id @default(autoincrement())
  sessionId String   @map("session_id")
  role      String
  content   String
  thinking  String?
  timeline  Json?
  createdAt DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Skill {
  id          String   @id
  name        String
  description String   @default("")
  category    String   @default("custom")
  owner       String   @default("")
  enabled     Boolean  @default(true)
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([owner, enabled])
}

model McpServer {
  id        String   @id
  name      String
  type      String            // "http" | "stdio"
  url       String   @default("")
  command   String   @default("")
  args      Json?
  headers   Json?
  owner     String   @default("") // 公共=""，私有=userId
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([owner, enabled])
}

model LlmProvider {
  id              String   @id @default(cuid())
  name            String
  model           String
  baseUrl         String
  apiKeyEnc       String   @default("")
  owner           String   @default("") // 公共=""，私有=userId
  isGlobalDefault Boolean  @default(false) @map("is_global_default") // 公共 provider 是否全员默认
  maxTokens       Int      @default(32768)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([owner])
}

// 每个用户独立的默认模型选择；无记录 = 使用 env 内置模型
model UserDefaultModel {
  owner      String   @id // preferred_username
  providerId String
  updatedAt  DateTime @updatedAt @map("updated_at")
}

// 用户记忆画像：对话提取/手动添加的用户偏好观察
model ProfileObservation {
  id         String   @id @default(cuid())
  owner      String   // 用户 id（preferred_username）
  content    String   // 观察内容，如"用户偏好简洁回复"
  confidence Float    @default(0.5) // 置信度 0-1
  source     String   @default("explicit") // explicit=手动 / auto=对话提取
  enabled    Boolean  @default(true)
  seenCount  Int      @default(1) // 出现次数（重复提取时提升）
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@index([owner])
}

model Setting {
  key   String @id
  value String
}
