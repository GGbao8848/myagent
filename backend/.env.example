# LLM provider configuration (OpenAI-compatible / vLLM)
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=http://localhost:8000/v1
DEEPAGENTS_MODEL=openai:gpt-4o

# Sandbox configuration
SANDBOX_PYTHON=.venv/bin/python        # Windows 用 .venv/Scripts/python.exe
SANDBOX_TIMEOUT=60

# WSL sandbox (Windows only) — 将 AI 代码路由到 WSL Linux 环境执行
# SANDBOX_WSL_ENABLED=true             # 启用 WSL 沙箱模式
# SANDBOX_WSL_DISTRO=Ubuntu            # WSL 分发版名称（默认自动检测）

# Sandbox security guards (optional)
# SANDBOX_AUDIT=true            # 开启 AST 静态审计
# SANDBOX_MEMORY_MB=512         # 子进程内存上限 (MB)，0 = 不限制
# SANDBOX_BLOCK_NETWORK=true    # 阻断子进程网络访问

# Daytona cloud sandbox (optional)
# SANDBOX_PROVIDER=daytona
# DAYTONA_API_KEY=dtn_xxx
# DAYTONA_SANDBOX_SNAPSHOT=

# Web UI
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Database & Profile
DB_PATH=data/br-agent.db
PROFILE_PATH=data/profile.json

# BIP 系统凭证
BIP_USERNAME=your-username
BIP_PASSWORD=your-password
