{
  "name": "br-agent",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/server",
    "dev:desktop": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/server",
    "build:desktop": "npm run build -w apps/desktop",
    "db:push": "npm run db:push -w apps/server",
    "db:generate": "npm run db:generate -w apps/server"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "prisma@6.16.0": true,
    "@prisma/client@6.16.0": true,
    "@prisma/engines@6.16.0": true,
    "electron@33.4.11": true
  }
}
